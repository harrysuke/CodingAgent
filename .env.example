# ---------------------------------------------------------------------------
# Coding Agent runtime configuration
# Copy to .env (or run `npm run setup` to generate one automatically).
# ---------------------------------------------------------------------------

# AES-256-GCM key (64 hex chars) used to decrypt the API keys stored in
# data/codingagent.db. This MUST match the key from the source FreeLLMAPI
# project, otherwise the 16 pre-existing provider keys cannot be read.
# Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# HTTP server
PORT=4317
HOST=127.0.0.1
# Shared secret for the UI. Desktop injects this automatically; mobile clients
# must enter the same value in Settings > Connection.
AGENT_TOKEN=change-me-local-dev-token

# Absolute path to the SQLite file copied from freellmapi_bak (renamed).
DB_PATH=./data/codingagent.db

# Root directory the agent is allowed to work in (defaults to the workspace).
# WORKSPACE_ROOT=D:/Nodejs/CodingAgent/workspace

# Agent defaults
AGENT_MAX_STEPS=30
AGENT_PERMISSION_MODE=ask
# Comma-separated extra CORS origins for mobile / LAN access
# EXTRA_ORIGINS=http://192.168.1.50:5173
