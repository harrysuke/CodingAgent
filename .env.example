# ---------------------------------------------------------------------------
# Coding Agent runtime configuration
# Copy to .env (or run `npm run setup` to generate one automatically).
# ---------------------------------------------------------------------------

# AES-256-GCM key (64 hex chars) used to decrypt the API keys stored in
# data/codingagent.db. This MUST match the key from the source FreeLLMAPI
# project, otherwise the 16 pre-existing provider keys cannot be read.
# Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# HTTP server
PORT=4317
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Accounts / BYOK
# ---------------------------------------------------------------------------
# One-time setup secret for the FIRST admin account only. It is NOT an API
# credential: after login every request uses a per-account session token
# (kept in the browser), and every account pays with only its own keys.
# `npm run setup` generates a strong random value here. To rotate later:
#   npm run rotate:setup-token
# On desktop this value lives in <app-data>/server.env and is prefilled by the
# app's first-run screen.
AGENT_TOKEN=change-me-local-dev-token

# Set to false to stop new account registration (existing accounts still work).
ALLOW_REGISTRATION=true
# Lifetime of a login session, in days.
AGENT_SESSION_TTL_DAYS=30
# Each non-admin account is confined to its own folder under this root.
USER_WORKSPACES_ROOT=./data/workspaces
# A shell can `cd ..` out of any in-process sandbox. Leave this false unless
# you fully trust every account on this machine.
AGENT_ALLOW_USER_SHELL=false

# Absolute path to the SQLite database. `npm run setup` copies a source
# FreeLLMAPI snapshot here when one exists; otherwise the server creates the
# file with every required table on first start (see `npm run db:migrate`).
DB_PATH=./data/codingagent.db

# Root directory the agent is allowed to work in (defaults to the workspace).
# WORKSPACE_ROOT=D:/Nodejs/CodingAgent/workspace

# Agent defaults
AGENT_MAX_STEPS=30
AGENT_PERMISSION_MODE=ask
# Comma-separated extra CORS origins for mobile / LAN access
# EXTRA_ORIGINS=http://192.168.1.50:5173
