{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodingAgent",
  "version": "0.1.0",
  "identifier": "com.codingagent.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodingAgent",
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/server": "server",
      "resources/node": "node"
    },
    "category": "DeveloperTool",
    "shortDescription": "An OpenCode-style local coding agent",
    "longDescription": "CodingAgent pairs a Node.js agent engine with a Vue 3 interface. It reuses the FreeLLMAPI SQLite database for model catalogues and encrypted provider keys, and runs entirely on localhost."
  }
}
